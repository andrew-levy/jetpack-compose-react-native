{
  "name": "jetpack-compose-react-native",
  "version": "0.1.0",
  "description": "Jetpack Compose in React Native",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json --pretty false && node --test tests/catalog.test.mjs tests/records.test.mjs tests/payloads.test.mjs",
    "catalog:fixtures": "tsc -p tsconfig.json --pretty false && node scripts/generate-catalog-fixtures.mjs",
    "android": "bash scripts/run-android.sh",
    "android:verify": "bash scripts/run-android.sh --verify",
    "example:prebuild": "npm --workspace example run prebuild",
    "start": "npm --workspace example run start",
    "prepack": "npm run build"
  },
  "keywords": [
    "react-native",
    "jetpack-compose-react-native",
    "JetpackComposeReactNative"
  ],
  "repository": "https://github.com/andrew-levy/jetpack-compose-react-native",
  "bugs": {
    "url": "https://github.com/andrew-levy/jetpack-compose-react-native/issues"
  },
  "author": "andrew-levy <alevy97@gmail.com> (https://github.com/andrew-levy)",
  "license": "MIT",
  "homepage": "https://github.com/andrew-levy/jetpack-compose-react-native#readme",
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.87.0"
  },
  "react-native": "src/index.ts",
  "workspaces": [
    "example"
  ],
  "codegenConfig": {
    "name": "JpcSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.jetpackcomposereactnative"
    }
  },
  "files": [
    "android",
    "cpp",
    "src",
    "build",
    "react-native.config.js",
    "!android/build",
    "!android/.cxx"
  ]
}
